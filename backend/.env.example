# Copy to .env. NEVER commit .env.
DATABASE_URL=postgresql+asyncpg://localhost:5432/vinatrade
JWT_SECRET=generate-a-long-random-string
DEBUG=true

# AI (Claude) — explanations, headline, assistant, weekly coach
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=50

# Admin seeded on first start
ADMIN_EMAIL=admin@vinatrade.vn
ADMIN_PASSWORD=admin-change-me
ADMIN_NAME=Admin

# Telegram bot (alerts). Empty → Telegram channel disabled
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Email (password reset, daily report). Empty → links are logged
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Vinatrade <no-reply@vinatrade.vn>

# Firebase push (service-account JSON path or inline JSON). Empty → push disabled
FIREBASE_CREDENTIALS=
GCP_CREDENTIALS_JSON=

# Public URLs
PUBLIC_WEB_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scheduler: run background jobs inside this process (set false for a worker-less API replica)
SCHEDULER_ENABLED=true
# Universe limit for dev (0 = all listed stocks)
UNIVERSE_LIMIT=0
MEDIA_ROOT=media
